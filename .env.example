# =============================================================================
#  bot_investimenti — variabili d'ambiente
#  Copia questo file in `.env.local` e riempi i valori.
#  L'app FUNZIONA anche con tutto vuoto: Yahoo Finance non richiede chiavi.
#  Le chiavi opzionali migliorano copertura e frequenza di aggiornamento.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — Neon Postgres (consigliato, gratis)
# -----------------------------------------------------------------------------
# Dove: https://console.neon.tech → Sign up (GitHub/Google) → New Project
#       → dashboard del progetto → riquadro "Connection string"
#       → seleziona "Pooled connection" → copia l'URL completo
# Piano free: 0,5 GB storage, 100 CU-ore/mese, scale-to-zero. Nessuna carta.
# Prima dell'uso esegui `db/schema.sql` nel SQL Editor di Neon.
# Se la lasci vuota l'app parte lo stesso: niente cache persistente, le
# classifiche vengono calcolate su un sottoinsieme di titoli a ogni avvio.
DATABASE_URL=

# -----------------------------------------------------------------------------
# CRON_SECRET — obbligatoria se usi il refresh schedulato
# -----------------------------------------------------------------------------
# Generala tu, non è di un servizio esterno:
#   openssl rand -hex 32
# Protegge /api/cron/refresh. Va messa anche nei GitHub Secrets del repo
# (Settings → Secrets and variables → Actions) e nelle env di Vercel.
CRON_SECRET=

# -----------------------------------------------------------------------------
# FINNHUB_API_KEY — opzionale. Abilita prezzi real-time USA via WebSocket
# -----------------------------------------------------------------------------
# Dove: https://finnhub.io/register → conferma email → https://finnhub.io/dashboard
#       la chiave è in cima alla pagina ("API Key").
# Piano free: 60 chiamate/minuto, WebSocket real-time solo mercati USA,
#             max 50 simboli in sottoscrizione. Nessuna carta.
# Senza questa chiave i titoli USA restano ritardati ~15 min (dato Yahoo).
FINNHUB_API_KEY=

# -----------------------------------------------------------------------------
# TWELVEDATA_API_KEY — opzionale. Fallback quote se Yahoo non risponde
# -----------------------------------------------------------------------------
# Dove: https://twelvedata.com/pricing → piano "Basic" (Free) → Get Started
#       → registrati → https://twelvedata.com/account/api-keys
# Piano free: 800 richieste/giorno, 8/minuto, copertura USA/forex/crypto.
#             Gli indici europei NON sono inclusi nel piano free.
TWELVEDATA_API_KEY=

# -----------------------------------------------------------------------------
# FMP_API_KEY — opzionale. Anagrafica titoli e ISIN mancanti
# -----------------------------------------------------------------------------
# Dove: https://site.financialmodelingprep.com/developer/docs → Sign Up
#       → Dashboard → "API Keys"
# Piano free: 250 richieste/giorno, principalmente mercato USA.
FMP_API_KEY=

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL — opzionale
# -----------------------------------------------------------------------------
# URL pubblico dell'app. In locale lascialo così. Su Vercel mettici il dominio
# assegnato (es. https://bot-investimenti.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
